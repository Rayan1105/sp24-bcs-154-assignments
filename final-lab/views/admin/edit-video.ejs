<!DOCTYPE html>
<html>
<head>
  <title>Edit Video</title>
  <style>
    body { font-family: Arial, sans-serif; padding: 20px; max-width: 600px; margin: 0 auto; }
    .form-group { margin-bottom: 15px; }
    label { display: block; margin-bottom: 5px; font-weight: bold; }
    input[type="text"], input[type="number"], select, input[type="file"] { width: 100%; padding: 8px; border: 1px solid #ccc; border-radius: 4px; box-sizing: border-box; }
    button { padding: 10px 15px; background-color: #065fd4; color: white; border: none; border-radius: 4px; cursor: pointer; font-size: 16px; }
    button:hover { background-color: #0056b3; }
    a { text-decoration: none; color: #065fd4; display: inline-block; margin-top: 15px; }
    .current-thumbnail { margin-top: 5px; max-width: 150px; display: block; }
  </style>
</head>
<body>
  <h1>Edit Video</h1>
  <form action="/admin/edit/<%= video._id %>" method="POST" enctype="multipart/form-data">
    <div class="form-group">
      <label>Title:</label>
      <input type="text" name="title" value="<%= video.title %>" required>
    </div>
    
    <div class="form-group">
      <label>Price ($):</label>
      <input type="number" name="price" step="0.01" value="<%= video.price %>" required>
    </div>
    
    <div class="form-group">
      <label>Category:</label>
      <select name="category" required>
        <option value="Gaming" <%= video.category === 'Gaming' ? 'selected' : '' %>>Gaming</option>
        <option value="Education" <%= video.category === 'Education' ? 'selected' : '' %>>Education</option>
        <option value="Entertainment" <%= video.category === 'Entertainment' ? 'selected' : '' %>>Entertainment</option>
        <option value="Tech" <%= video.category === 'Tech' ? 'selected' : '' %>>Tech</option>
        <option value="Music" <%= video.category === 'Music' ? 'selected' : '' %>>Music</option>
      </select>
    </div>
    
    <div class="form-group">
      <label>Rating (1-5):</label>
      <input type="number" name="rating" step="0.1" min="1" max="5" value="<%= video.rating %>" required>
    </div>
    
    <div class="form-group">
      <label>Stock:</label>
      <input type="number" name="stock" value="<%= video.stock %>" required>
    </div>
    
    <div class="form-group">
      <label>Thumbnail Image (Leave blank to keep current):</label>
      <input type="file" name="thumbnail" accept="image/*">
      <p>Current Thumbnail:</p>
      <img src="<%= video.thumbnail %>" class="current-thumbnail" alt="Current Thumbnail">
    </div>
    
    <button type="submit">Update Video</button>
  </form>
  <br>
  <a href="/admin">Back to Dashboard</a>
</body>
</html>
