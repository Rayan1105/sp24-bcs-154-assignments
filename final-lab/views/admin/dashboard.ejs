<!DOCTYPE html>
<html>
<head>
  <title>Admin Dashboard</title>
  <style>
    body { font-family: Arial, sans-serif; padding: 20px; }
    table { width: 100%; border-collapse: collapse; margin-top: 20px; }
    th, td { padding: 10px; border: 1px solid #ddd; text-align: left; }
    th { background-color: #f4f4f4; }
    .btn { padding: 5px 10px; text-decoration: none; color: white; background-color: #065fd4; border-radius: 3px; border: none; cursor: pointer; }
    .btn-danger { background-color: #cc0000; }
    .btn-add { background-color: #28a745; margin-bottom: 20px; display: inline-block; }
    .action-forms { display: inline; }
  </style>
</head>
<body>
  <h1>Admin Dashboard</h1>
  <a href="/admin/add" class="btn btn-add">Add New Video</a>
  
  <table>
    <thead>
      <tr>
        <th>Thumbnail</th>
        <th>Title</th>
        <th>Price</th>
        <th>Stock</th>
        <th>Category</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% videos.forEach(video => { %>
        <tr>
          <td><img src="<%= video.thumbnail %>" alt="Thumbnail" width="80"></td>
          <td><%= video.title %></td>
          <td>$<%= video.price.toFixed(2) %></td>
          <td><%= video.stock %></td>
          <td><%= video.category %></td>
          <td>
            <a href="/admin/edit/<%= video._id %>" class="btn">Edit</a>
            <form action="/admin/delete/<%= video._id %>" method="POST" class="action-forms" onsubmit="return confirm('Are you sure you want to delete this video?');">
              <button type="submit" class="btn btn-danger">Delete</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</body>
</html>
